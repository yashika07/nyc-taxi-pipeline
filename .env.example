# Copy this file to .env and fill in your actual Snowflake trial credentials
# Never commit the real .env file — it's already in .gitignore

SNOWFLAKE_ACCOUNT=your_account_identifier      # e.g. xy12345.us-east-1
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=TLC_WH
SNOWFLAKE_DATABASE=TLC_DB
SNOWFLAKE_SCHEMA=RAW
